# Copy to .env.production on the VPS; never commit real credentials.
# Canonical public address for the single chat service.
WEBUI_URL=https://chat.gcat.ir
WEBUI_AUTH=true
ENABLE_SIGNUP=false
ENABLE_PASSWORD_AUTH=true
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
# Forward signed user identity to gateway for metering and subscription quotas
ENABLE_FORWARD_USER_INFO_HEADERS=true
FORWARD_USER_INFO_HEADER_JWT_SECRET=REPLACE_WITH_SHARED_JWT_SECRET_48_CHARS
FORWARD_USER_INFO_HEADER_JWT_EXPIRES_SECONDS=300

OPENAI_API_BASE_URL=http://host.docker.internal:20128/v1
OPENAI_API_KEY=
OLLAMA_BASE_URL=
